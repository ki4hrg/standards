# Every variable the app reads. Keep in step with docs/DEPLOYMENT.md.

# Local dev: postgres on localhost (see CLAUDE.md for the docker run line).
DATABASE_URL=postgres://__APP__@localhost:54329/__APP__
PGPASSWORD=change-me
POSTGRES_PASSWORD=change-me
# 32+ random bytes: openssl rand -base64 48
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
APP_PORT=3000

# Optional single sign-on (all three or none).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ONLY=
OIDC_TRUST_EMAIL=

TZ=America/New_York
